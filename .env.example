# HTTP server
HOST=0.0.0.0
PORT=3000

# AI Agent Office connection. A bare ws(s) origin is expanded to /ws/workers.
# Use wss:// and a public https:// worker URL outside a trusted local network.
AI_HARNESS_OFFICE_URL=ws://127.0.0.1:8005/ws/workers
AI_HARNESS_WORKER_TOKEN=replace-with-the-office-worker-token
# Development only: set false to accept an invalid/self-signed certificate.
AI_HARNESS_OFFICE_TLS_REJECT_UNAUTHORIZED=true

# Public agent identity and credential-free advertised endpoint. Set this when
# the office or its users cannot reach the worker at its local listen address.
WORKER_NAME=Coding Worker Agent
WORKER_DESCRIPTION=Completes coding tasks in its configured workspace.
WORKER_PUBLIC_URL=http://127.0.0.1:3000

# Agent execution
WORKER_WORKSPACE=.workspace
WORKER_CONCURRENCY=1
# Direct questions use a separate queue so they never block socket reception.
WORKER_DIRECT_MESSAGE_CONCURRENCY=2
WORKER_MAX_TURNS=30
WORKER_MAX_MESSAGE_BYTES=1000000
WORKER_TOOLS=list_files,read_file,write_file,search_files,curl,run_command,read_office_context,list_teammates,ask_teammate
# Optional JSON array overriding the skills advertised to AI Agent Office.
WORKER_SKILLS=
WORKER_TASK_DB=db/tasks.sqlite
WORKER_RECONNECT_MIN_MS=1000
WORKER_RECONNECT_MAX_MS=30000
WORKER_HEARTBEAT_MS=30000

# Local Codex adapter (`npm run start:codex`). Empty model/profile values use
# the defaults from the locally installed and authenticated Codex CLI.
CODEX_EXECUTABLE=codex
CODEX_WORKER_NAME=
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=workspace-write
CODEX_EPHEMERAL=false
CODEX_MAX_DIAGNOSTIC_BYTES=32768

# Model provider. Any hosted provider name uses the OpenAI-compatible Chat
# Completions protocol; names beginning with "ollama" (such as "ollama-local")
# select Ollama's native API.
# OpenRouter example: openrouter / https://openrouter.ai/api/v1 / <key> / openai/gpt-5.6-sol
PROVIDER_NAME=ollama-local
PROVIDER_URL=http://localhost:11434
PROVIDER_API_KEY=
PROVIDER_MODEL=qwen3-coder:30b

# System prompts. These are the defaults from lib/system-prompts.js and can be
# edited here without changing source code. Keep {{root}}, {{platform}},
# {{date}}, {{tools}}, and {{paths}} placeholders where their runtime values
# should be inserted.
AI_HARNESS_PROMPT_REFINEMENT="Rewrite the user's request into a precise prompt for a downstream coding agent.
Preserve the user's intent, constraints, file paths, identifiers, quoted text, and requested scope.
Clarify implicit implementation requirements when they follow directly from the request, but do not
invent features, requirements, or facts. Return only the refined prompt with no commentary. If the
request is already precise, return it unchanged."

AI_HARNESS_AGENT_INSTRUCTIONS="You are a pragmatic coding agent operating in a local workspace.
Inspect the repository before making assumptions. Use tools to read relevant files, make focused
changes, and run verification. Keep existing project conventions. Never claim a command passed
unless you ran it. Avoid destructive commands. Do not access paths outside the workspace.
After every mutation, validate that it succeeded. Do not report a task as complete until you have
validated its outcome. If validation cannot run or fails, state that clearly."

AI_HARNESS_WORKSPACE_CONTEXT="Workspace root: {{root}}
Treat this directory as your current working directory and the root of the repository. Use the
available file tools to inspect and modify files in this workspace.
All file reads and writes must stay inside this workspace.
Platform: {{platform}}
Current date: {{date}}"

AI_HARNESS_TOOL_CONTRACT="Tool capability contract:
{{tools}}

Every tool listed above is available. Inspect the workspace rather than guessing, and use the
relevant enabled tool before claiming that file or command access is unavailable. Enabled tools
and MCP servers are authorized to run without an additional approval prompt.
Never claim that you lack file or command access without first checking the enabled tools."

AI_HARNESS_RESPONSE_FORMAT="Return the final response as Markdown. When you create a file, include a clickable
Markdown link to it using {{resource_base_url}} followed by its percent-encoded workspace-relative
path. Do not use local filesystem paths as the link target."

AI_HARNESS_VALIDATION_REMINDER="Harness validation is still required for: {{paths}}. Run read_file on each
changed file or run a relevant test, build, lint, or status command. Do not provide a final answer
until validation succeeds."

# Optional MCP server configuration as JSON. The harness also automatically
# reads WORKER_WORKSPACE/.ai-harness/config.toml when this is empty.
# Example: {"mcp":{"servers":[{"server_label":"docs","server_url":"https://example.com/mcp"}]}}
AI_HARNESS_MCP_SERVERS=
